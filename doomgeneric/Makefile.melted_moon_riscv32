OBJS := $(SRC_DOOM:%.c=$(OBJDIR)/%.o)
OBJS_RV32_ASM := $(SRC_RV32_ASM_DOOM:%.s=$(OBJDIR)/%.o)
#OBJS += $(addprefix $(OBJDIR)/, $(SRC_DOOM))
#OBJS_RV32_ASM += $(addprefix $(OBJDIR), $(SRC_RV32_ASM_DOOM))

all:	 $(OUTPUT_BIN) #$(OUTPUT_DIS)

clean:
	rm -rf $(OBJDIR)
	rm -f $(OUTPUT_ELF)
	rm -f $(OUTPUT_BIN)
	rm -f $(OUTPUT_DIS)
	rm -f $(OUTPUT_PREFIX).gdb
	rm -f $(OUTPUT_PREFIX).map

$(OUTPUT_BIN): $(OUTPUT_ELF)
	riscv32-unknown-elf-objcopy -O binary $(OUTPUT_ELF) $(OUTPUT_BIN)

$(OUTPUT_DIS): $(OUTPUT_ELF)
	riscv32-unknown-elf-objdump -D $(OUTPUT_ELF) > $(OUTPUT_DIS)

$(OUTPUT_ELF): $(OBJS) $(OBJS_RV32_ASM)
	@#echo [Linking $@]
	$(VB)$(CC) $(LDFLAGS) $(OBJS) $(OBJS_RV32_ASM) \
	-o $(OUTPUT_ELF) $(LIBS) -Wl,-Map,$(OUTPUT_PREFIX).map
	@#echo [Size]
	@#-$(CROSS_COMPILE)size $(OUTPUT)

$(OBJS): | $(OBJDIR)

$(OBJS_RV32_ASM): | $(OBJDIR)

$(OBJDIR):
	mkdir -p $(OBJDIR)

$(OBJS): $(OBJDIR)/%.o: %.c
	@#echo [Compiling $<]
	$(VB)$(CC) $(CFLAGS) -c $< -o $@

$(OBJS_RV32_ASM) : $(OBJDIR)/%.o : %.s
	riscv32-unknown-elf-as $(RV32_ASFLAGS) -c $< -o $@

print:
	@echo OBJS: $(OBJS)

