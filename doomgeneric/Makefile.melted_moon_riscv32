RV32_SUFFIX:=-riscv32$(RV32_SUFFIX)

# subdirectory for objects
OBJDIR=build$(RV32_SUFFIX)
OUTPUT_PREFIX=doomgeneric$(RV32_SUFFIX)
OUTPUT_ELF=$(OUTPUT_PREFIX).elf
OUTPUT_BIN=$(OUTPUT_PREFIX).bin
OUTPUT_DIS=$(OUTPUT_PREFIX)-dis.s

CC=riscv32-unknown-elf-gcc #clang  # gcc or g++
#CFLAGS+=-ggdb3 -Os
CFLAGS:=$(RV32_CFLAGS)
#LDFLAGS+=#-Wl,--gc-sections
LDFLAGS:= \
	$(MY_RV32_ARCH_ABI_FLAGS) \
	-std=gnu99 \
	-Wl,-Bstatic \
	-L/home/fl4shk/local/picolibc/melted_moon_riscv32-unknown-elf/lib \
	-L/home/fl4shk/local/lib/gcc/riscv32-unknown-elf/17.0.0 \
	-L/home/fl4shk/local/lib/gcc/riscv32-unknown-elf/17.0.0/include \
	-specs=picolibc.specs

#CFLAGS+=-ggdb3 -Wall -DNORMALUNIX -DLINUX -DSNDSERV -D_DEFAULT_SOURCE # -DUSEASM
